# --------------------------------------------------------------------------
# Database
# --------------------------------------------------------------------------
# Pooled connection for the running app (recommended for serverless/runtime use)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require&pgbouncer=true"

# Direct connection for Prisma CLI commands such as db:push and migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# --------------------------------------------------------------------------
# OpenAI (optional - enables AI-generated executive summaries)
# If omitted, a rule-based summary is generated instead.
# --------------------------------------------------------------------------
OPENAI_API_KEY="sk-..."

# --------------------------------------------------------------------------
# Resend (email delivery)
# --------------------------------------------------------------------------
RESEND_API_KEY="re_..."
# This address must be on a domain verified in Resend.
RESEND_FROM_EMAIL="Bryant Digital Solutions <info@bryantdigitalsolutions.com>"
ADMIN_EMAIL="ajbryantsleads@gmail.com"

# --------------------------------------------------------------------------
# Google PageSpeed Insights (optional - enables real Core Web Vitals data)
# If omitted, performance is estimated from page weight and response time.
# --------------------------------------------------------------------------
PAGESPEED_API_KEY=""
GOOGLE_PLACES_API_KEY=""
GOOGLE_PLACE_ID=""
GOOGLE_REVIEWS_URL="https://share.google/CXVLfLhnIW2oIhY9i"

# --------------------------------------------------------------------------
# Admin dashboard
# --------------------------------------------------------------------------
ADMIN_PASSWORD="your-secure-admin-password"

# --------------------------------------------------------------------------
# Session signing secret (used to sign the admin auth cookie)
# --------------------------------------------------------------------------
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --------------------------------------------------------------------------
# Public app URL (used in email links, must be reachable by recipients)
# --------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Comma-separated browser origins permitted to call the hosted API.
# Include both the custom GitHub Pages domain and the project Pages URL if it is live.
ALLOWED_ORIGINS="https://bryantdigitalsolutions.com,https://www.bryantdigitalsolutions.com,https://mgt581.github.io"
