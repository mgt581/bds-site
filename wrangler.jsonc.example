{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bds-site-preview",
  "pages_build_output_dir": ".",
  "compatibility_date": "2026-08-14",
  "d1_databases": [
    {
      "binding": "LEADS_DB",
      "database_name": "bds-site-leads-preview",
      "database_id": "REPLACE_WITH_PREVIEW_D1_DATABASE_ID"
    }
  ],
  "vars": {
    "BUSINESS_NAME": "Bryant Digital Solutions",
    "LEAD_FROM_EMAIL": "Bryant Digital Solutions <info@bryantdigitalsolutions.com>",
    "LEAD_TO_EMAILS": "ajbryantsleads@gmail.com",
    "CLOUDFLARE_ACCESS_ENABLED": "true"
  }
}
